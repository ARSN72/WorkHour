{
  "manifest_version": 3,
  "name": "Work Hour Calculator",
  "short_name": "Work Hour",
  "version": "1.0.0",
  "description": "A local-first work time calculator.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "optional_permissions": [
    "scripting"
  ],
  "optional_host_permissions": [
    "https://walkover.keka.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Work Hour Calculator",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  }
}